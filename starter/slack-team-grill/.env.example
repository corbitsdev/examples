PORT=3001
PUBLIC_BASE_URL=https://your-public-tunnel.example

# PUBLIC_BASE_URL is setup-only; the process does not read it. Configure both
# Slack request URLs to:
#   Events API:    ${PUBLIC_BASE_URL}/api/tag/slack/webhook
#   Interactivity: ${PUBLIC_BASE_URL}/api/tag/slack/webhook

# Slack HTTP Events and Interactivity ingress.
# Keep these secret. Do not commit real values.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...

# Socket Mode is disabled and no app-level token is used.

# Interchange inference. Configure one provider.
ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_BASE_URL=
# GOOGLE_MODEL=gemini-2.0-flash

# Optional provider and model overrides.
# INTX_PROVIDER=anthropic
# INTX_MODEL=claude-sonnet-4-6
