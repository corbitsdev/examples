PORT=3001
PUBLIC_BASE_URL=https://your-public-tunnel.example

# PUBLIC_BASE_URL is a setup convenience, not a runtime input. Use it for the
# Slack Events API request URL:
#   ${PUBLIC_BASE_URL}/api/tag/slack/webhook

# Slack ingress. Keep these secret. Do not commit real values.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...

# Inference: set one provider key.
ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# GOOGLE_API_KEY=
# Public research
EXA_API_KEY=
# Optional: enables opening full pages when Exa's excerpt is insufficient.
FIRECRAWL_API_KEY=

# Optional inference overrides.
# INTX_PROVIDER=anthropic
# INTX_MODEL=claude-sonnet-4-6
