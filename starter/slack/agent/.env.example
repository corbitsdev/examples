# HTTP server
PORT=3001
PUBLIC_BASE_URL=https://your-public-tunnel.example

# PUBLIC_BASE_URL is a setup convenience, not a runtime input. Use it when
# configuring Slack's Events API Request URL:
#   ${PUBLIC_BASE_URL}/api/tag/slack/webhook

# Slack ingress
# Keep these secret. Do not commit real values. The current Corbits Tag
# integration uses Slack's HTTP Events API, so it requires the signing secret
# and bot token.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...

# Keep this placeholder if you adapt the starter to a Socket Mode transport.
# The current manifest disables Socket Mode and cli.ts does not read this var.
# SLACK_APP_TOKEN=xapp-...

# Interchange inference
# The current minimal starter uses Anthropic directly.
ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Alternative provider settings are intentionally retained as extension
# options. If you change the `source` block in cli.ts to select one of these
# providers, the rest of the Slack and Interchange agent flow stays unchanged.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# GOOGLE_API_KEY=

# Optional provider-selection names retained for examples that add automatic
# source resolution. The current minimal cli.ts does not read them.
# INTX_PROVIDER=anthropic
# INTX_MODEL=claude-sonnet-4-6
