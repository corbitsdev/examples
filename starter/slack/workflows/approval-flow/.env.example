PORT=3001
PUBLIC_BASE_URL=https://your-public-tunnel.example

# PUBLIC_BASE_URL is a setup convenience, not a runtime input. Use it for
# both Slack request URLs:
#   Events API:   ${PUBLIC_BASE_URL}/api/tag/slack/webhook
#   Interactivity: ${PUBLIC_BASE_URL}/api/tag/slack/webhook

# Slack ingress
# Keep these secret. Do not commit real values.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...

# The Corbits workflow uses Slack's HTTP APIs. Keep this placeholder only if
# you later adapt it to a Socket Mode transport.
# SLACK_APP_TOKEN=xapp-...

# Interchange inference. Pick whichever provider you have configured.
ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# GOOGLE_API_KEY=

# Optional provider and model overrides.
# INTX_PROVIDER=anthropic
# INTX_MODEL=claude-sonnet-4-6
