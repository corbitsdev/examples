PORT=3001
PUBLIC_BASE_URL=https://your-public-tunnel.example

# Configure Slack's Events API Request URL as:
#   ${PUBLIC_BASE_URL}/api/tag/slack/webhook
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...

# Set one model-provider key. Empty values are ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional provider and model overrides.
# INTX_PROVIDER=anthropic
# INTX_MODEL=claude-sonnet-4-6
